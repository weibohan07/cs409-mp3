# Copy this file to .env, then fill in your own database credentials.
# .env is ignored by git. Never commit a real database password or connection string.
# TOKEN is retained from the course starter; this API does not expose or require it.
TOKEN=secret-starter-mern
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional local port. Render supplies PORT automatically.
# PORT=3000

# Optional course self-check target: the PUBLIC origin, without /api.
# You can alternatively edit API_URL in submit.js.
# API_URL=https://YOUR-APP-NAME.onrender.com
